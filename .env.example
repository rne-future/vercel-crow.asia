# Runtime (Supabase pooler — JANGAN pakai direct 5432 di Vercel function)
DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DDL/migrasi hanya dari CI/lokal
DIRECT_URL=postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres?sslmode=require

# Auth.js (server-only)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase (SERVICE_ROLE_KEY server-only, tanpa prefix NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mayar (server-only)
MAYAR_API_KEY=
MAYAR_BASE_URL=
MAYAR_WEBHOOK_TOKEN=

# Cloudflare R2 (server-only, kecuali PUBLIC_URL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
