# PostgreSQL lokal atau Supabase: runtime dapat memakai pooler; DDL memakai koneksi langsung.
DATABASE_URL=
DIRECT_URL=

# Auth.js (server-only)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:4050
APP_URL=http://localhost:4050

# Supabase (SERVICE_ROLE_KEY server-only, tanpa prefix NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mayar (server-only)
MAYAR_API_KEY=
MAYAR_BASE_URL=
MAYAR_WEBHOOK_TOKEN=
# Optional trusted-gateway HMAC contract: x-webhook-signature: sha256=<hex>.
# Leave empty for direct Mayar callbacks; this is not an assumed Mayar signature header.
MAYAR_WEBHOOK_SIGNING_SECRET=

# Supabase Storage (server-only). Bucket private; PDF diambil lewat signed URL.
SUPABASE_STORAGE_BUCKET=playbooks

# Supabase Storage S3: opsional untuk tooling upload, tidak dipakai route download REST.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Vercel CLI/API: untuk deployment, tidak diperlukan runtime aplikasi.
VERCEL_TOKEN=
